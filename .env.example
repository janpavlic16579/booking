# Kopiraj v .env in prilagodi vrednosti.

# Vrata, na katerih teče strežnik (lokalno).
PORT=3000

# Geslo za admin prijavo. OBVEZNO spremeni v produkciji!
# Sprememba gesla razveljavi vse obstoječe admin seje.
ADMIN_PASSWORD=Marjetka123

# Povezava na Postgres (Neon, "pooled" povezava). Na Vercelu jo ustvari
# Storage → Neon. Če ni nastavljena, se lokalno uporabi vgrajena baza PGlite.
# DATABASE_URL=postgresql://uporabnik:geslo@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Mapa lokalne baze PGlite (uporabljena samo brez DATABASE_URL).
PGLITE_DIR=./data/pglite

# Trajanje admin seje v urah.
SESSION_TTL_HOURS=12
